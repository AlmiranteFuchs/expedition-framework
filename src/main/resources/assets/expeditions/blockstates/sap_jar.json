{
  "multipart": [
    {
      "apply": {
        "model": "expeditions:block/sap_jar"
      }
    },
    {
      "when": {
        "sap_level": "1",
        "water": "false"
      },
      "apply": {
        "model": "expeditions:block/sap_jar_sap_1"
      }
    },
    {
      "when": {
        "sap_level": "2",
        "water": "false"
      },
      "apply": {
        "model": "expeditions:block/sap_jar_sap_2"
      }
    },
    {
      "when": {
        "sap_level": "3",
        "water": "false"
      },
      "apply": {
        "model": "expeditions:block/sap_jar_sap_3"
      }
    },
    {
      "when": {
        "sap_level": "4",
        "water": "false"
      },
      "apply": {
        "model": "expeditions:block/sap_jar_sap_4"
      }
    },
    {
      "when": {
        "water": "true"
      },
      "apply": {
        "model": "expeditions:block/sap_jar_water"
      }
    }
  ]
}
