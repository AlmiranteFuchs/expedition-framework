{
  "multipart": [
    {
      "when": { "down": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer" }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer", "x": 180 }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer", "x": 270, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer", "x": 90, "uvlock": true }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer", "x": 90, "y": 270, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "expeditions:block/assimilation_layer", "x": 90, "y": 90, "uvlock": true }
    },
    {
      "when": { "tuft": "true" },
      "apply": [
        { "model": "expeditions:block/bloom_tuft_a" },
        { "model": "expeditions:block/bloom_tuft_b" },
        { "model": "expeditions:block/bloom_tuft_c" }
      ]
    },
    {
      "when": { "drip": "true" },
      "apply": [
        { "model": "expeditions:block/bloom_drip_a" },
        { "model": "expeditions:block/bloom_drip_b" }
      ]
    }
  ]
}
